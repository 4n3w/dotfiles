keybind = shift+enter=text:\n

theme = Rose Pine

# Rose Pine icon styling
macos-icon = custom-style
macos-icon-screen-color = 191724
macos-icon-ghost-color = f6c177
macos-icon-frame = beige

# Visual enhancements
window-padding-x = 10
window-padding-y = 10
background-opacity = 1
background-blur-radius = 20

# Font styling
font-family = "Berkeley Mono"
font-size = 15
font-thicken = true

# Cursor
cursor-style = block
cursor-style-blink = true

# Your original keybind plus some extras
keybind = shift+enter=text:\n
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+comma=reload_config
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1

# Workspace integration
working-directory = $HOME/workspace
window-width = 120
window-height = 40

# SSH: install Ghostty terminfo on remote hosts, fall back to xterm-256color
shell-integration-features = ssh-terminfo,ssh-env
